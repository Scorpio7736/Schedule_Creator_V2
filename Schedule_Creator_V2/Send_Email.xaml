<Page x:Class="Schedule_Creator_V2.Send_Email"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Schedule_Creator_V2"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1000"
      Title="Send Email">

    <Grid>

        <Border Margin="20"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- PAGE HEADER -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="Create Email"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                    <TextBlock Margin="0,5,0,0"
                               Text="Select an email type, choose the recipients, and complete the email information."
                               FontSize="14"
                               Foreground="#6B7280"/>

                </StackPanel>

                <!-- MAIN CONTENT -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===================================================== -->
                    <!-- LEFT COLUMN                                           -->
                    <!-- ===================================================== -->

                    <Grid Grid.Column="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- EMAIL TYPE -->
                        <Border Grid.Row="0"
                                Padding="16"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8">

                            <StackPanel>

                                <TextBlock Text="Email Type"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <TextBlock Margin="0,4,0,10"
                                           Text="Choose the type of email to create."
                                           TextWrapping="Wrap"
                                           Foreground="#6B7280"/>

                                <ComboBox x:Name="EmailTypeComboBox"
                                          Height="36"
                                          Padding="8,4"
                                          VerticalContentAlignment="Center"
                                          ItemsSource="{Binding EmailTypes}"
                                          DisplayMemberPath="displayName"
                                          SelectionChanged="EmailTypeComboBox_SelectionChanged"/>

                            </StackPanel>

                        </Border>

                        <!-- RECIPIENTS -->
                        <Border Grid.Row="2"
                                MinHeight="260"
                                Background="#FAFCFB"
                                BorderBrush="#DDE5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Recipient heading -->
                                <Border Grid.Row="0"
                                        Padding="12"
                                        Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="Recipients"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>

                                        <Grid Grid.Row="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Height="30"
                                                    Padding="8,3"
                                                    Content="Select All"
                                                    Click="SelectAllStaffButton_Click"/>

                                            <Button Grid.Column="2"
                                                    Height="30"
                                                    Padding="8,3"
                                                    Content="Clear"
                                                    Click="ClearStaffSelectionButton_Click"/>

                                        </Grid>

                                    </Grid>

                                </Border>

                                <!-- Recipient list -->
                                <DataGrid x:Name="StaffListBox"
                                          Grid.Row="1"
                                          ItemsSource="{Binding RecipientSelections}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="False"
                                          CanUserResizeRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E1E8E4"
                                          VerticalGridLinesBrush="Transparent"
                                          RowHeaderWidth="0"
                                          RowHeight="44"
                                          ColumnHeaderHeight="38"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          IsReadOnly="False"
                                          Background="White"
                                          BorderThickness="0"
                                          AlternatingRowBackground="#FAFCFB"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <DataGrid.Resources>

                                        <Style TargetType="DataGridColumnHeader">

                                            <Setter Property="Background"
                                                    Value="#EAF2EE"/>

                                            <Setter Property="Foreground"
                                                    Value="#315E4D"/>

                                            <Setter Property="FontSize"
                                                    Value="11"/>

                                            <Setter Property="FontWeight"
                                                    Value="SemiBold"/>

                                            <Setter Property="Padding"
                                                    Value="12,7"/>

                                            <Setter Property="BorderBrush"
                                                    Value="#D6E1DC"/>

                                            <Setter Property="BorderThickness"
                                                    Value="0,0,0,1"/>

                                        </Style>

                                        <Style TargetType="DataGridRow">

                                            <Setter Property="Background"
                                                    Value="White"/>

                                            <Setter Property="BorderThickness"
                                                    Value="0"/>

                                            <Style.Triggers>

                                                <Trigger Property="AlternationIndex"
                                                         Value="1">

                                                    <Setter Property="Background"
                                                            Value="#FAFCFB"/>

                                                </Trigger>

                                                <Trigger Property="IsMouseOver"
                                                         Value="True">

                                                    <Setter Property="Background"
                                                            Value="#F0F7F3"/>

                                                </Trigger>

                                                <Trigger Property="IsSelected"
                                                         Value="True">

                                                    <Setter Property="Background"
                                                            Value="#E4F1EB"/>

                                                    <Setter Property="Foreground"
                                                            Value="#1F2937"/>

                                                </Trigger>

                                            </Style.Triggers>

                                        </Style>

                                        <Style TargetType="DataGridCell">

                                            <Setter Property="Padding"
                                                    Value="12,6"/>

                                            <Setter Property="BorderThickness"
                                                    Value="0"/>

                                            <Setter Property="VerticalContentAlignment"
                                                    Value="Center"/>

                                            <Setter Property="FocusVisualStyle"
                                                    Value="{x:Null}"/>

                                        </Style>

                                        <Style x:Key="RecipientCheckBoxStyle"
                                               TargetType="CheckBox">

                                            <Setter Property="Width"
                                                    Value="18"/>

                                            <Setter Property="Height"
                                                    Value="18"/>

                                            <Setter Property="Margin"
                                                    Value="0"/>

                                            <Setter Property="Padding"
                                                    Value="0"/>

                                            <Setter Property="HorizontalAlignment"
                                                    Value="Center"/>

                                            <Setter Property="VerticalAlignment"
                                                    Value="Center"/>

                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Center"/>

                                            <Setter Property="VerticalContentAlignment"
                                                    Value="Center"/>

                                            <Setter Property="Cursor"
                                                    Value="Hand"/>

                                        </Style>

                                    </DataGrid.Resources>

                                    <DataGrid.Columns>

                                        <!-- STAFF NAME -->
                                        <DataGridTextColumn Header="STAFF MEMBER"
                                                            Width="*"
                                                            MinWidth="150"
                                                            IsReadOnly="True"
                                                            Binding="{Binding Staff.displayName}">

                                            <DataGridTextColumn.ElementStyle>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="VerticalAlignment"
                                                            Value="Center"/>

                                                    <Setter Property="FontSize"
                                                            Value="13"/>

                                                    <Setter Property="Foreground"
                                                            Value="#293A34"/>

                                                    <Setter Property="TextTrimming"
                                                            Value="CharacterEllipsis"/>

                                                </Style>

                                            </DataGridTextColumn.ElementStyle>

                                        </DataGridTextColumn>

                                        <!-- TO -->
                                        <DataGridTemplateColumn Header="TO"
                                                                Width="58">

                                            <DataGridTemplateColumn.HeaderStyle>

                                                <Style TargetType="DataGridColumnHeader"
                                                       BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">

                                                    <Setter Property="HorizontalContentAlignment"
                                                            Value="Center"/>

                                                </Style>

                                            </DataGridTemplateColumn.HeaderStyle>

                                            <DataGridTemplateColumn.CellTemplate>

                                                <DataTemplate>

                                                    <CheckBox Style="{StaticResource RecipientCheckBoxStyle}"
                                                              ToolTip="Add as a primary recipient"
                                                              IsChecked="{Binding IsTo,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"/>

                                                </DataTemplate>

                                            </DataGridTemplateColumn.CellTemplate>

                                        </DataGridTemplateColumn>

                                        <!-- CC -->
                                        <DataGridTemplateColumn Header="CC"
                                                                Width="58">

                                            <DataGridTemplateColumn.HeaderStyle>

                                                <Style TargetType="DataGridColumnHeader"
                                                       BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">

                                                    <Setter Property="HorizontalContentAlignment"
                                                            Value="Center"/>

                                                </Style>

                                            </DataGridTemplateColumn.HeaderStyle>

                                            <DataGridTemplateColumn.CellTemplate>

                                                <DataTemplate>

                                                    <CheckBox Style="{StaticResource RecipientCheckBoxStyle}"
                                                              ToolTip="Add as a CC recipient"
                                                              IsChecked="{Binding IsCc,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"/>

                                                </DataTemplate>

                                            </DataGridTemplateColumn.CellTemplate>

                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>

                        </Border>

                    </Grid>

                    <!-- ===================================================== -->
                    <!-- RIGHT COLUMN                                          -->
                    <!-- ===================================================== -->

                    <Border Grid.Column="2"
                            Padding="20"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- EMAIL INFORMATION HEADER -->
                            <StackPanel Grid.Row="0">

                                <TextBlock Text="Email Information"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <TextBlock Margin="0,4,0,0"
                                           Text="Complete the fields below. Custom emails can add or remove optional sections."
                                           TextWrapping="Wrap"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                            <!-- ================================================= -->
                            <!-- CUSTOM EMAIL SECTION MANAGER                      -->
                            <!-- ================================================= -->

                            <Border x:Name="EmailSectionManagerBorder"
                                    Grid.Row="2"
                                    Padding="14"
                                    Visibility="Collapsed"
                                    Background="#EEF6F2"
                                    BorderBrush="#C7DED3"
                                    BorderThickness="1"
                                    CornerRadius="7">

                                <StackPanel>

                                    <TextBlock Text="Customize Sections"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#244C3D"/>

                                    <TextBlock Margin="0,3,0,12"
                                               Text="Header, body, signature, and footer are required. Optional sections can be added or removed."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="#5D746B"/>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ADD SECTION -->
                                        <StackPanel Grid.Column="0">

                                            <TextBlock Margin="0,0,0,5"
                                                       Text="Add Section"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"/>

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox x:Name="EmailSectionComboBox"
                                                          Grid.Column="0"
                                                          Height="34"
                                                          Padding="7,3"
                                                          DisplayMemberPath="DisplayName"
                                                          VerticalContentAlignment="Center"/>

                                                <Button x:Name="AddEmailSectionButton"
                                                        Grid.Column="2"
                                                        MinWidth="65"
                                                        Height="34"
                                                        Padding="10,3"
                                                        Background="#006633"
                                                        BorderBrush="#006633"
                                                        Foreground="White"
                                                        Content="Add"
                                                        Click="AddEmailSectionButton_Click"/>

                                            </Grid>

                                        </StackPanel>

                                        <!-- REMOVE SECTION -->
                                        <StackPanel Grid.Column="2">

                                            <TextBlock Margin="0,0,0,5"
                                                       Text="Remove Section"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"/>

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox x:Name="RemoveEmailSectionComboBox"
                                                          Grid.Column="0"
                                                          Height="34"
                                                          Padding="7,3"
                                                          DisplayMemberPath="DisplayName"
                                                          VerticalContentAlignment="Center"/>

                                                <Button x:Name="RemoveEmailSectionButton"
                                                        Grid.Column="2"
                                                        MinWidth="75"
                                                        Height="34"
                                                        Padding="10,3"
                                                        Content="Remove"
                                                        Click="RemoveEmailSectionButton_Click"/>

                                            </Grid>

                                        </StackPanel>

                                    </Grid>

                                </StackPanel>

                            </Border>

                            <!-- GENERATED INPUT CONTROLS -->
                            <ScrollViewer Grid.Row="4"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <StackPanel x:Name="EmailInputFieldsPanel"/>

                            </ScrollViewer>

                        </Grid>

                    </Border>

                </Grid>

                <!-- ========================================================= -->
                <!-- BOTTOM BUTTONS                                            -->
                <!-- ========================================================= -->

                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Complete the email information before generating the email."
                               Foreground="#6B7280"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button x:Name="PreviewEmailButton"
                                MinWidth="110"
                                Height="38"
                                Padding="15,5"
                                Content="Preview"
                                Click="PreviewEmailButton_Click"/>

                        <Button x:Name="GenerateEmailButton"
                                MinWidth="120"
                                Height="38"
                                Margin="10,0,0,0"
                                Padding="15,5"
                                Background="#006633"
                                BorderBrush="#006633"
                                Foreground="White"
                                Content="Generate Email"
                                Click="GenerateEmailButton_Click"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Page>