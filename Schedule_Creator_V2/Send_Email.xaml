<Page x:Class="Schedule_Creator_V2.Send_Email"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Schedule_Creator_V2"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1000"
      Title="Send Email">

    <Grid>

        <Border Margin="20"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="Create Email"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                    <TextBlock Margin="0,5,0,0"
                               Text="Select an email type, choose the recipients, and complete the required fields."
                               FontSize="14"
                               Foreground="#6B7280"/>

                </StackPanel>

                <!-- Main Content -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <Grid Grid.Column="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Email Type Selection -->
                        <Border Grid.Row="0"
                                Padding="16"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8">

                            <StackPanel>

                                <TextBlock Text="Email Type"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <TextBlock Margin="0,4,0,10"
                                           Text="Choose the type of email to create."
                                           TextWrapping="Wrap"
                                           Foreground="#6B7280"/>

                                <ComboBox x:Name="EmailTypeComboBox"
                                          Height="36"
                                          Padding="8,4"
                                          VerticalContentAlignment="Center"
                                          ItemsSource="{Binding EmailTypes}"
                                          DisplayMemberPath="displayName"
                                          SelectionChanged="EmailTypeComboBox_SelectionChanged"/>

                            </StackPanel>

                        </Border>

                        <!-- Staff Selection -->
                        <Border Grid.Row="2"
                                Padding="16"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Select Staff"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <!-- Staff Selection Buttons -->
                                <StackPanel Grid.Row="1"
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal">

                                    <Button x:Name="SelectAllStaffButton"
                                            Padding="10,5"
                                            Content="Select All"
                                            Click="SelectAllStaffButton_Click"/>

                                    <Button x:Name="ClearStaffSelectionButton"
                                            Margin="8,0,0,0"
                                            Padding="10,5"
                                            Content="Clear"
                                            Click="ClearStaffSelectionButton_Click"/>

                                </StackPanel>

                                <!-- Staff List -->
                                <Border Grid.Row="3"
                                        Background="White"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        CornerRadius="5">

                                    <ListBox x:Name="StaffListBox"
                                             ItemsSource="{Binding StaffMembers}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             SelectionMode="Multiple"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                        <ListBox.ItemContainerStyle>

                                            <Style TargetType="ListBoxItem">

                                                <Setter Property="HorizontalContentAlignment"
                                                        Value="Stretch"/>

                                                <Setter Property="Padding"
                                                        Value="0"/>

                                            </Style>

                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>

                                            <DataTemplate>

                                                <CheckBox Margin="8,5"
                                                          VerticalAlignment="Center"
                                                          Content="{Binding displayName}"
                                                          IsChecked="{Binding IsSelected,
                                                              RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                              Mode=TwoWay}"/>

                                            </DataTemplate>

                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                </Border>

                            </Grid>

                        </Border>

                    </Grid>

                    <!-- Dynamic Email Input Area -->
                    <Border Grid.Column="2"
                            Padding="20"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">

                                <TextBlock Text="Email Information"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <TextBlock Margin="0,4,0,0"
                                           Text="The required input fields will appear below after an email type is selected."
                                           TextWrapping="Wrap"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <!-- Controls are generated here -->
                                <StackPanel x:Name="EmailInputFieldsPanel"/>

                            </ScrollViewer>

                        </Grid>

                    </Border>

                </Grid>

                <!-- Bottom Buttons -->
                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Complete the email information before generating or sending the email."
                               Foreground="#6B7280"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button x:Name="PreviewEmailButton"
                                MinWidth="110"
                                Height="38"
                                Padding="15,5"
                                Content="Preview"
                                Click="PreviewEmailButton_Click"/>

                        <Button x:Name="GenerateEmailButton"
                                MinWidth="120"
                                Height="38"
                                Margin="10,0,0,0"
                                Padding="15,5"
                                Background="#006633"
                                BorderBrush="#006633"
                                Foreground="White"
                                Content="Generate Email"
                                Click="GenerateEmailButton_Click"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Page>