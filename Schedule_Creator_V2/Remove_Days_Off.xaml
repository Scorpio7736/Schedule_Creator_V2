<Page x:Class="Schedule_Creator_V2.Remove_Days_Off"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1100"
      Title="Remove Days Off"
      Background="#F1F5F3"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- Main cards -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDE5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="24"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect BlurRadius="14"
                                      Direction="270"
                                      ShadowDepth="3"
                                      Opacity="0.08"
                                      Color="#143D30"/>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Field labels -->
        <Style x:Key="FieldLabelStyle"
               TargetType="Label">

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#293A34"/>

        </Style>

        <!-- Staff selector -->
        <Style TargetType="ComboBox">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- Date inputs -->
        <Style TargetType="DatePicker">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- Cancel button -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="105"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F1F5F3"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#849B90"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E5ECE8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Remove button -->
        <Style x:Key="DangerButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="175"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Background"
                    Value="#B42318"/>

            <Setter Property="BorderBrush"
                    Value="#B42318"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#922018"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#922018"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#741710"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.50"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="28"
                  MaxWidth="1050"
                  HorizontalAlignment="Stretch">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page heading -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="54"
                            Height="54"
                            VerticalAlignment="Top"
                            Background="#FDE8E5"
                            CornerRadius="12">

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="26"
                                   Foreground="#B42318"
                                   Text="&#xE74D;"/>

                    </Border>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Remove Days Off"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>

                        <TextBlock Margin="0,5,0,0"
                                   MaxWidth="780"
                                   Text="Remove previously recorded time-off entries for a staff member within a selected date range."
                                   FontSize="14"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Foreground="#66736D"/>

                    </StackPanel>

                </Grid>

                <!-- Main content -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Removal form -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Card heading -->
                            <StackPanel Grid.Row="0">

                                <TextBlock Text="Time-Off Removal"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <TextBlock Margin="0,5,0,0"
                                           Text="Select the staff member and the range of dates to remove."
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                            <!-- Form fields -->
                            <Grid Grid.Row="2">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Staff member -->
                                <StackPanel Grid.Row="0">

                                    <Label x:Name="StaffMemberLabel"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Content="Staff Member"/>

                                    <ComboBox x:Name="StaffComboBox"
                                              DisplayMemberPath="displayName"/>

                                    <TextBlock Margin="1,6,0,0"
                                               Text="Choose the staff member whose time-off entries should be removed."
                                               FontSize="12"
                                               LineHeight="17"
                                               TextWrapping="Wrap"
                                               Foreground="#7A8680"/>

                                </StackPanel>

                                <!-- Date range -->
                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <Label x:Name="StartDateLabel"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Content="Start Date"/>

                                        <DatePicker x:Name="StartDatePicker"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <Label x:Name="EndDateLabel"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Content="End Date"/>

                                        <DatePicker x:Name="EndDatePicker"/>

                                    </StackPanel>

                                </Grid>

                            </Grid>

                            <!-- Actions -->
                            <StackPanel Grid.Row="4"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">

                                <Button x:Name="CancelButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CancelBtnClick"
                                        Content="Reset"/>

                                <Button x:Name="SaveButton"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="SaveBtnClick">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Margin="0,0,7,0"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Text="&#xE74D;"/>

                                        <TextBlock Text="Remove Days Off"/>

                                    </StackPanel>

                                </Button>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- Information panel -->
                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <Border Width="48"
                                    Height="48"
                                    HorizontalAlignment="Left"
                                    Background="#FDE8E5"
                                    CornerRadius="10">

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="23"
                                           Foreground="#B42318"
                                           Text="&#xE7BA;"/>

                            </Border>

                            <TextBlock Margin="0,16,0,0"
                                       Text="Deletion Information"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>

                            <TextBlock Margin="0,8,0,0"
                                       Text="Every saved day-off entry between the selected start and end dates will be deleted for the chosen staff member."
                                       FontSize="13"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       Foreground="#66736D"/>

                            <!-- Checklist -->
                            <Border Margin="0,20,0,0"
                                    Padding="14"
                                    Background="#F5F8F6"
                                    BorderBrush="#D9E4DF"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <StackPanel>

                                    <TextBlock Text="Before removing"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#315E4D"/>

                                    <TextBlock Margin="0,7,0,0"
                                               Text="• Confirm the staff member"
                                               FontSize="12"
                                               Foreground="#52635C"/>

                                    <TextBlock Margin="0,5,0,0"
                                               Text="• Confirm the start date"
                                               FontSize="12"
                                               Foreground="#52635C"/>

                                    <TextBlock Margin="0,5,0,0"
                                               Text="• Confirm the end date"
                                               FontSize="12"
                                               Foreground="#52635C"/>

                                    <TextBlock Margin="0,5,0,0"
                                               Text="• Make sure the range is correct"
                                               FontSize="12"
                                               Foreground="#52635C"/>

                                </StackPanel>

                            </Border>

                            <!-- Warning -->
                            <Border Margin="0,16,0,0"
                                    Padding="14"
                                    Background="#FFF1EF"
                                    BorderBrush="#EDC0BA"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock VerticalAlignment="Top"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="#B42318"
                                               Text="&#xE814;"/>

                                    <TextBlock Margin="9,0,0,0"
                                               Text="This removes the saved records immediately. Recreate them from Add Days Off if they are removed accidentally."
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Foreground="#7A3028"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </ScrollViewer>

    </Grid>

</Page>