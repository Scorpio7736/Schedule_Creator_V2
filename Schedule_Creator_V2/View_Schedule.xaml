<Page x:Class="Schedule_Creator_V2.View_Schedule"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1150"
      Title="View Schedule"
      Background="#F1F5F3"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- Main card -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDE5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="22"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect BlurRadius="14"
                                      Direction="270"
                                      ShadowDepth="3"
                                      Opacity="0.08"
                                      Color="#143D30"/>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Schedule selector -->
        <Style TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- Schedule grid -->
        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E5EBE8"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="RowHeaderWidth"
                    Value="0"/>

            <Setter Property="RowHeight"
                    Value="52"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="48"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FAFCFB"/>

            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#EAF2EE"/>

            <Setter Property="Foreground"
                    Value="#234438"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="13,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#D6E1DC"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

        </Style>

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Style.Triggers>

                <Trigger Property="AlternationIndex"
                         Value="1">

                    <Setter Property="Background"
                            Value="#FAFCFB"/>

                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F0F7F3"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#DDEFE7"/>

                    <Setter Property="Foreground"
                            Value="#1F2937"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="Padding"
                    Value="13,8"/>

            <Setter Property="BorderBrush"
                    Value="#E5EBE8"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

    </Page.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="54"
                    Height="54"
                    VerticalAlignment="Top"
                    Background="#DDEFE7"
                    CornerRadius="12">

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="26"
                           Foreground="#0F5640"
                           Text="&#xE787;"/>

            </Border>

            <StackPanel Grid.Column="2">

                <TextBlock Text="View Schedule"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>

                <TextBlock Margin="0,5,0,0"
                           MaxWidth="820"
                           Text="Select a saved schedule to review staff assignments across the configured operating days."
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="#66736D"/>

            </StackPanel>

        </Grid>

        <!-- Main schedule card -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Card heading -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Saved Schedule"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>

                        <TextBlock Margin="0,5,0,0"
                                   Text="Choose a schedule to display its weekly staff assignments."
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="11,6"
                            VerticalAlignment="Center"
                            Background="#EAF2EE"
                            BorderBrush="#D4E2DB"
                            BorderThickness="1"
                            CornerRadius="6">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="#315E4D"
                                       Text="&#xE8A5;"/>

                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#315E4D"
                                       Text="SAVED SCHEDULES"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- Schedule selector -->
                <Border Grid.Row="2"
                        Padding="18"
                        Background="#F8FAF9"
                        BorderBrush="#E1E8E4"
                        BorderThickness="1"
                        CornerRadius="9">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <StackPanel Orientation="Horizontal">

                                <Border Width="38"
                                        Height="38"
                                        Margin="0,0,11,0"
                                        Background="#E7F2ED"
                                        CornerRadius="8">

                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#0F5640"
                                               Text="&#xE823;"/>

                                </Border>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Schedule Selection"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#293A34"/>

                                    <TextBlock Margin="0,2,0,0"
                                               Text="Select the saved schedule you want to review."
                                               FontSize="11"
                                               Foreground="#7A8680"/>

                                </StackPanel>

                            </StackPanel>

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">

                            <TextBlock Margin="0,0,0,7"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#293A34"
                                       Text="Select Schedule"/>

                            <ComboBox x:Name="ScheduleComboBox"
                                      SelectionChanged="FillBoxes"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- Schedule results -->
                <Border Grid.Row="4"
                        MinHeight="340"
                        Background="White"
                        BorderBrush="#DDE5E1"
                        BorderThickness="1"
                        CornerRadius="9"
                        ClipToBounds="True">

                    <Grid>

                        <DataGrid x:Name="ScheduleGrid">

                            <DataGrid.Columns>

                                <DataGridTextColumn x:Name="MonCol"
                                                    Width="*"
                                                    MinWidth="140"
                                                    Visibility="Hidden"
                                                    Binding="{Binding AvailMon}"
                                                    Header="Monday"/>

                                <DataGridTextColumn x:Name="TueCol"
                                                    Width="*"
                                                    MinWidth="140"
                                                    Visibility="Hidden"
                                                    Binding="{Binding AvailTue}"
                                                    Header="Tuesday"/>

                                <DataGridTextColumn x:Name="WedCol"
                                                    Width="*"
                                                    MinWidth="140"
                                                    Visibility="Hidden"
                                                    Binding="{Binding AvailWed}"
                                                    Header="Wednesday"/>

                                <DataGridTextColumn x:Name="ThuCol"
                                                    Width="*"
                                                    MinWidth="140"
                                                    Visibility="Hidden"
                                                    Binding="{Binding AvailThu}"
                                                    Header="Thursday"/>

                                <DataGridTextColumn x:Name="FriCol"
                                                    Width="*"
                                                    MinWidth="140"
                                                    Visibility="Hidden"
                                                    Binding="{Binding AvailFri}"
                                                    Header="Friday"/>

                                <DataGridTextColumn x:Name="SatCol"
                                                    Width="*"
                                                    MinWidth="140"
                                                    Visibility="Hidden"
                                                    Binding="{Binding AvailSat}"
                                                    Header="Saturday"/>

                                <DataGridTextColumn x:Name="SunCol"
                                                    Width="*"
                                                    MinWidth="140"
                                                    Visibility="Hidden"
                                                    Binding="{Binding AvailSun}"
                                                    Header="Sunday"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>