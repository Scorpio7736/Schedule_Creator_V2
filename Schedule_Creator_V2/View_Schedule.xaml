<Page x:Class="Schedule_Creator_V2.View_Schedule"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1200"
      Title="View Schedule"
      Background="#F1F5F3"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- Main card -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDE5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="22"/>

            <Setter Property="Effect">
                <Setter.Value>

                    <DropShadowEffect BlurRadius="14"
                                      Direction="270"
                                      ShadowDepth="3"
                                      Opacity="0.08"
                                      Color="#143D30"/>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Schedule selector -->
        <Style TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="#849B90"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="#0F5640"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Staff name -->
        <Style x:Key="StaffNameStyle"
               TargetType="TextBlock">

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>

        <!-- Shift time -->
        <Style x:Key="ShiftTimeStyle"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#315E4D"/>

        </Style>

        <!-- Schedule grid -->
        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="All"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E5EBE8"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#E5EBE8"/>

            <Setter Property="RowHeaderWidth"
                    Value="0"/>

            <Setter Property="RowHeight"
                    Value="96"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="48"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FAFCFB"/>

            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#EAF2EE"/>

            <Setter Property="Foreground"
                    Value="#234438"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="13,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#D6E1DC"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

        </Style>

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>

            <Style.Triggers>

                <Trigger Property="AlternationIndex"
                         Value="1">

                    <Setter Property="Background"
                            Value="#FAFCFB"/>

                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F0F7F3"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#DDEFE7"/>

                    <Setter Property="Foreground"
                            Value="#1F2937"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="Padding"
                    Value="9"/>

            <Setter Property="BorderBrush"
                    Value="#E5EBE8"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

    </Page.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="54"
                    Height="54"
                    VerticalAlignment="Top"
                    Background="#DDEFE7"
                    CornerRadius="12">

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="26"
                           Foreground="#0F5640"
                           Text="&#xE787;"/>

            </Border>

            <StackPanel Grid.Column="2">

                <TextBlock Text="View Schedule"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>

                <TextBlock Margin="0,5,0,0"
                           MaxWidth="850"
                           Text="Select a saved schedule to review staff assignments and shift times across the configured operating days."
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="#66736D"/>

            </StackPanel>

        </Grid>

        <!-- Main schedule card -->
        <Border Grid.Row="2"
                HorizontalAlignment="Stretch"
                Style="{StaticResource CardStyle}">

            <Grid HorizontalAlignment="Stretch">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Card heading -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Saved Schedule"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>

                        <TextBlock Margin="0,5,0,0"
                                   Text="Choose a schedule to display its weekly staff assignments and shift times."
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="11,6"
                            VerticalAlignment="Center"
                            Background="#EAF2EE"
                            BorderBrush="#D4E2DB"
                            BorderThickness="1"
                            CornerRadius="6">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="#315E4D"
                                       Text="&#xE8A5;"/>

                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#315E4D"
                                       Text="SAVED SCHEDULES"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- Schedule selector -->
                <Border Grid.Row="2"
                        Padding="18"
                        Background="#F8FAF9"
                        BorderBrush="#E1E8E4"
                        BorderThickness="1"
                        CornerRadius="9">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <StackPanel Orientation="Horizontal">

                                <Border Width="38"
                                        Height="38"
                                        Margin="0,0,11,0"
                                        Background="#E7F2ED"
                                        CornerRadius="8">

                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#0F5640"
                                               Text="&#xE823;"/>

                                </Border>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Schedule Selection"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#293A34"/>

                                    <TextBlock Margin="0,2,0,0"
                                               Text="Select the saved schedule you want to review."
                                               FontSize="11"
                                               Foreground="#7A8680"/>

                                </StackPanel>

                            </StackPanel>

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">

                            <TextBlock Margin="0,0,0,7"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#293A34"
                                       Text="Select Schedule"/>

                            <ComboBox x:Name="ScheduleComboBox"
                                      SelectionChanged="FillBoxes"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- Schedule results -->
                <Border Grid.Row="4"
                        MinHeight="340"
                        HorizontalAlignment="Stretch"
                        Background="White"
                        BorderBrush="#DDE5E1"
                        BorderThickness="1"
                        CornerRadius="9"
                        ClipToBounds="True">

                    <DataGrid x:Name="ScheduleGrid"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              ColumnWidth="*">

                        <DataGrid.Columns>

                            <!-- Monday -->
                            <DataGridTemplateColumn x:Name="MonCol"
                                                    Width="*"
                                                    MinWidth="190"
                                                    Header="Monday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding AvailMon}"
                                                       Style="{StaticResource StaffNameStyle}"/>

                                            <Border Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Padding="8,5"
                                                    HorizontalAlignment="Center"
                                                    Background="#EAF2EE"
                                                    BorderBrush="#D4E2DB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Foreground="#315E4D"
                                                               Text="&#xE823;"/>

                                                    <TextBlock Text="{Binding MonStartTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Margin="5,0"
                                                               Text="–"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Text="{Binding MonEndTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                </StackPanel>

                                            </Border>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Tuesday -->
                            <DataGridTemplateColumn x:Name="TueCol"
                                                    Width="*"
                                                    MinWidth="190"
                                                    Header="Tuesday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding AvailTue}"
                                                       Style="{StaticResource StaffNameStyle}"/>

                                            <Border Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Padding="8,5"
                                                    HorizontalAlignment="Center"
                                                    Background="#EAF2EE"
                                                    BorderBrush="#D4E2DB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Foreground="#315E4D"
                                                               Text="&#xE823;"/>

                                                    <TextBlock Text="{Binding TueStartTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Margin="5,0"
                                                               Text="–"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Text="{Binding TueEndTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                </StackPanel>

                                            </Border>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Wednesday -->
                            <DataGridTemplateColumn x:Name="WedCol"
                                                    Width="*"
                                                    MinWidth="190"
                                                    Header="Wednesday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding AvailWed}"
                                                       Style="{StaticResource StaffNameStyle}"/>

                                            <Border Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Padding="8,5"
                                                    HorizontalAlignment="Center"
                                                    Background="#EAF2EE"
                                                    BorderBrush="#D4E2DB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Foreground="#315E4D"
                                                               Text="&#xE823;"/>

                                                    <TextBlock Text="{Binding WedStartTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Margin="5,0"
                                                               Text="–"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Text="{Binding WedEndTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                </StackPanel>

                                            </Border>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Thursday -->
                            <DataGridTemplateColumn x:Name="ThuCol"
                                                    Width="*"
                                                    MinWidth="190"
                                                    Header="Thursday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding AvailThu}"
                                                       Style="{StaticResource StaffNameStyle}"/>

                                            <Border Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Padding="8,5"
                                                    HorizontalAlignment="Center"
                                                    Background="#EAF2EE"
                                                    BorderBrush="#D4E2DB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Foreground="#315E4D"
                                                               Text="&#xE823;"/>

                                                    <TextBlock Text="{Binding ThuStartTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Margin="5,0"
                                                               Text="–"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Text="{Binding ThuEndTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                </StackPanel>

                                            </Border>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Friday -->
                            <DataGridTemplateColumn x:Name="FriCol"
                                                    Width="*"
                                                    MinWidth="190"
                                                    Header="Friday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding AvailFri}"
                                                       Style="{StaticResource StaffNameStyle}"/>

                                            <Border Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Padding="8,5"
                                                    HorizontalAlignment="Center"
                                                    Background="#EAF2EE"
                                                    BorderBrush="#D4E2DB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Foreground="#315E4D"
                                                               Text="&#xE823;"/>

                                                    <TextBlock Text="{Binding FriStartTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Margin="5,0"
                                                               Text="–"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Text="{Binding FriEndTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                </StackPanel>

                                            </Border>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Saturday -->
                            <DataGridTemplateColumn x:Name="SatCol"
                                                    Width="*"
                                                    MinWidth="190"
                                                    Header="Saturday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding AvailSat}"
                                                       Style="{StaticResource StaffNameStyle}"/>

                                            <Border Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Padding="8,5"
                                                    HorizontalAlignment="Center"
                                                    Background="#EAF2EE"
                                                    BorderBrush="#D4E2DB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Foreground="#315E4D"
                                                               Text="&#xE823;"/>

                                                    <TextBlock Text="{Binding SatStartTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Margin="5,0"
                                                               Text="–"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Text="{Binding SatEndTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                </StackPanel>

                                            </Border>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Sunday -->
                            <DataGridTemplateColumn x:Name="SunCol"
                                                    Width="*"
                                                    MinWidth="190"
                                                    Header="Sunday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding AvailSun}"
                                                       Style="{StaticResource StaffNameStyle}"/>

                                            <Border Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Padding="8,5"
                                                    HorizontalAlignment="Center"
                                                    Background="#EAF2EE"
                                                    BorderBrush="#D4E2DB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Foreground="#315E4D"
                                                               Text="&#xE823;"/>

                                                    <TextBlock Text="{Binding SunStartTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Margin="5,0"
                                                               Text="–"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                    <TextBlock Text="{Binding SunEndTime,
                                                                             StringFormat={}{0:h:mm tt}}"
                                                               Style="{StaticResource ShiftTimeStyle}"/>

                                                </StackPanel>

                                            </Border>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Page>