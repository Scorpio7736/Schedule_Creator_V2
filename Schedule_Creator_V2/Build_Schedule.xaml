<Page x:Class="Schedule_Creator_V2.Build_Schedule"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1200"
      Title="Build Schedule"
      Background="#F1F5F3"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- Main card -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDE5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="22"/>

            <Setter Property="Effect">
                <Setter.Value>

                    <DropShadowEffect BlurRadius="14"
                                      Direction="270"
                                      ShadowDepth="3"
                                      Opacity="0.08"
                                      Color="#143D30"/>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Staff selector -->
        <Style TargetType="ComboBox">

            <Setter Property="MinHeight"
                    Value="38"/>

            <Setter Property="MinWidth"
                    Value="150"/>

            <Setter Property="Padding"
                    Value="9,5"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

        </Style>

        <!-- Time selector -->
        <Style x:Key="ShiftTimePickerStyle"
               TargetType="{x:Type xctk:TimePicker}">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="MinWidth"
                    Value="100"/>

            <Setter Property="Padding"
                    Value="7,3"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Format"
                    Value="Custom"/>

            <Setter Property="FormatString"
                    Value="h:mm tt"/>

            <Setter Property="TimeInterval"
                    Value="00:15:00"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- Time field label -->
        <Style x:Key="ShiftTimeLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Margin"
                    Value="1,0,0,3"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#66736D"/>

        </Style>

        <!-- Schedule name -->
        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="11,7"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="#849B90"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="#0F5640"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Dynamic row-delete button -->
        <Style TargetType="Button">

            <Setter Property="MinWidth"
                    Value="72"/>

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Padding"
                    Value="11,4"/>

            <Setter Property="Background"
                    Value="#FFF1EF"/>

            <Setter Property="BorderBrush"
                    Value="#EDC0BA"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#B42318"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FDE3DF"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D78076"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F6CFC9"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.50"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="145"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Background"
                    Value="#0F5640"/>

            <Setter Property="BorderBrush"
                    Value="#0F5640"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#174E3D"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#174E3D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0A3E2E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="110"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F1F5F3"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#849B90"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E5ECE8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Clear button -->
        <Style x:Key="DangerButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="135"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Background"
                    Value="#FFF7F6"/>

            <Setter Property="BorderBrush"
                    Value="#E4AAA3"/>

            <Setter Property="Foreground"
                    Value="#B42318"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FDE8E5"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D78076"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F7D2CD"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Auto-generate button -->
        <Style x:Key="AutoGenerateButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="190"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Background"
                    Value="#EAF2EE"/>

            <Setter Property="BorderBrush"
                    Value="#A9C7BA"/>

            <Setter Property="Foreground"
                    Value="#0F5640"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#DCECE5"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#6FA58D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#CDE2D9"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Schedule grid -->
        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="GridLinesVisibility"
                    Value="All"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E5EBE8"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#E5EBE8"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="RowHeaderWidth"
                    Value="0"/>

            <Setter Property="RowHeight"
                    Value="126"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="48"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FAFCFB"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#EAF2EE"/>

            <Setter Property="Foreground"
                    Value="#234438"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="#D6E1DC"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

        </Style>

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>

            <Style.Triggers>

                <Trigger Property="AlternationIndex"
                         Value="1">

                    <Setter Property="Background"
                            Value="#FAFCFB"/>

                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F0F7F3"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#DDEFE7"/>

                    <Setter Property="Foreground"
                            Value="#1F2937"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="Padding"
                    Value="7"/>

            <Setter Property="BorderBrush"
                    Value="#E5EBE8"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

    </Page.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="54"
                    Height="54"
                    VerticalAlignment="Top"
                    Background="#DDEFE7"
                    CornerRadius="12">

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="26"
                           Foreground="#0F5640"
                           Text="&#xE787;"/>

            </Border>

            <StackPanel Grid.Column="2">

                <TextBlock Text="Build Schedule"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>

                <TextBlock Margin="0,5,0,0"
                           MaxWidth="850"
                           Text="Assign a staff member and individual start and end time to every shift on each operating day."
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="#66736D"/>

            </StackPanel>

        </Grid>

        <!-- Main schedule card -->
        <Border Grid.Row="2"
                HorizontalAlignment="Stretch"
                Style="{StaticResource CardStyle}">

            <Grid HorizontalAlignment="Stretch">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Card heading -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Shift Assignments"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>

                            <TextBlock Margin="9,1,0,0"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="#5B7469"
                                       Text="&#xE946;">

                                <TextBlock.ToolTip>

                                    <ToolTip>

                                        <TextBlock Width="300"
                                                   TextWrapping="Wrap"
                                                   Text="Each cell contains its own staff assignment, start time, and end time. Only days configured in Job Hour Settings are displayed."/>

                                    </ToolTip>

                                </TextBlock.ToolTip>

                            </TextBlock>

                        </StackPanel>

                        <TextBlock Margin="0,5,0,0"
                                   Text="Each row represents one shift across the available operating days."
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="#6B7280"/>

                    </StackPanel>

                    <Button x:Name="AutoComplete_BTN"
                            Grid.Column="1"
                            Style="{StaticResource AutoGenerateButtonStyle}"
                            Click="AutoComplete_BTN_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Margin="0,0,8,0"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE895;"/>

                            <TextBlock Text="Auto Generate Schedule"/>

                        </StackPanel>

                    </Button>

                </Grid>

                <!-- Schedule grid -->
                <Border Grid.Row="2"
                        MinHeight="320"
                        HorizontalAlignment="Stretch"
                        Background="White"
                        BorderBrush="#DDE5E1"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">

                    <DataGrid x:Name="ScheduleGrid"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              ColumnWidth="*"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <!-- Monday -->
                            <DataGridTemplateColumn x:Name="MonCol"
                                                    Width="*"
                                                    MinWidth="250"
                                                    Header="Monday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="2"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <ContentControl Grid.Row="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding MonBox.Key}"/>

                                            <Grid Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  HorizontalAlignment="Stretch">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="START"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="MonStartTimePicker"
                                                                     Value="{Binding MonStartTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="END"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="MonEndTimePicker"
                                                                     Value="{Binding MonEndTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Tuesday -->
                            <DataGridTemplateColumn x:Name="TueCol"
                                                    Width="*"
                                                    MinWidth="250"
                                                    Header="Tuesday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="2"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <ContentControl Grid.Row="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding TueBox.Key}"/>

                                            <Grid Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  HorizontalAlignment="Stretch">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="START"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="TueStartTimePicker"
                                                                     Value="{Binding TueStartTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="END"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="TueEndTimePicker"
                                                                     Value="{Binding TueEndTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Wednesday -->
                            <DataGridTemplateColumn x:Name="WedCol"
                                                    Width="*"
                                                    MinWidth="250"
                                                    Header="Wednesday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="2"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <ContentControl Grid.Row="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding WedBox.Key}"/>

                                            <Grid Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  HorizontalAlignment="Stretch">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="START"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="WedStartTimePicker"
                                                                     Value="{Binding WedStartTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="END"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="WedEndTimePicker"
                                                                     Value="{Binding WedEndTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Thursday -->
                            <DataGridTemplateColumn x:Name="ThuCol"
                                                    Width="*"
                                                    MinWidth="250"
                                                    Header="Thursday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="2"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <ContentControl Grid.Row="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding ThuBox.Key}"/>

                                            <Grid Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  HorizontalAlignment="Stretch">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="START"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="ThuStartTimePicker"
                                                                     Value="{Binding ThuStartTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="END"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="ThuEndTimePicker"
                                                                     Value="{Binding ThuEndTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Friday -->
                            <DataGridTemplateColumn x:Name="FriCol"
                                                    Width="*"
                                                    MinWidth="250"
                                                    Header="Friday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="2"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <ContentControl Grid.Row="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding FriBox.Key}"/>

                                            <Grid Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  HorizontalAlignment="Stretch">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="START"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="FriStartTimePicker"
                                                                     Value="{Binding FriStartTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="END"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="FriEndTimePicker"
                                                                     Value="{Binding FriEndTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Saturday -->
                            <DataGridTemplateColumn x:Name="SatCol"
                                                    Width="*"
                                                    MinWidth="250"
                                                    Header="Saturday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="2"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <ContentControl Grid.Row="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding SatBox.Key}"/>

                                            <Grid Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  HorizontalAlignment="Stretch">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="START"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="SatStartTimePicker"
                                                                     Value="{Binding SatStartTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="END"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="SatEndTimePicker"
                                                                     Value="{Binding SatEndTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Sunday -->
                            <DataGridTemplateColumn x:Name="SunCol"
                                                    Width="*"
                                                    MinWidth="250"
                                                    Header="Sunday"
                                                    Visibility="Hidden">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid Margin="2"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <ContentControl Grid.Row="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding SunBox.Key}"/>

                                            <Grid Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  HorizontalAlignment="Stretch">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="START"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="SunStartTimePicker"
                                                                     Value="{Binding SunStartTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Stretch">

                                                    <TextBlock Text="END"
                                                               Style="{StaticResource ShiftTimeLabelStyle}"/>

                                                    <xctk:TimePicker x:Name="SunEndTimePicker"
                                                                     Value="{Binding SunEndTime,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ShiftTimePickerStyle}"/>

                                                </StackPanel>

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- Remove row -->
                            <DataGridTemplateColumn x:Name="DelCol"
                                                    Width="100"
                                                    MinWidth="100"
                                                    MaxWidth="100"
                                                    Header="Remove"
                                                    Visibility="Visible">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">

                                            <ContentControl HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding DelBTN}"/>

                                        </Grid>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

                <!-- Schedule name and actions -->
                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Schedule name -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Schedule Name"
                                   Margin="0,0,0,7"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#293A34"/>

                        <TextBox x:Name="ScheduleNameBox"
                                 ToolTip="Enter a unique name for this schedule"/>

                        <TextBlock Margin="1,6,0,0"
                                   Text="The name must be unique before the schedule can be saved."
                                   FontSize="11"
                                   Foreground="#7A8680"/>

                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">

                        <Button x:Name="ClearButton"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ClearSchedule_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Margin="0,0,7,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE74D;"/>

                                <TextBlock Text="Clear Schedule"/>

                            </StackPanel>

                        </Button>

                        <Button x:Name="AddRowButton"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="AddRow_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Margin="0,0,7,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE710;"/>

                                <TextBlock Text="Add Row"/>

                            </StackPanel>

                        </Button>

                        <Button x:Name="SaveButton"
                                Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveSchedule_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Margin="0,0,7,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE74E;"/>

                                <TextBlock Text="Save Schedule"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Page>