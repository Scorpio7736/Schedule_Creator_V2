<Window x:Class="Schedule_Creator_V2.Auto_Generate_Options"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Generate Schedule"
        Width="560"
        Height="680"
        MinWidth="500"
        MinHeight="560"
        MaxHeight="850"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F3"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Card -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDE5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="20"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect BlurRadius="14"
                                      Direction="270"
                                      ShadowDepth="3"
                                      Opacity="0.08"
                                      Color="#143D30"/>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Staff count TextBox -->
        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- Staff exclusion checkbox -->
        <Style TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="#293A34"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="130"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Background"
                    Value="#0F5640"/>

            <Setter Property="BorderBrush"
                    Value="#0F5640"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#174E3D"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#174E3D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0A3E2E"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.50"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="105"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F1F5F3"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#849B90"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E5ECE8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ScrollBar -->
        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="12"/>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="24,22"
                Background="#0F5640">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="52"
                        Height="52"
                        Background="#25FFFFFF"
                        CornerRadius="12">

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="25"
                               Foreground="White"
                               Text="&#xE895;"/>

                </Border>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">

                    <TextBlock Text="Auto Generate Schedule"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Margin="0,4,0,0"
                               Text="Choose the schedule size and optional exclusions."
                               FontSize="13"
                               Foreground="#D5E9E2"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="24">

                <!-- Staff per day -->
                <Border Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Staff Per Day"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>

                            <TextBlock Margin="0,5,0,0"
                                       Text="Enter the requested number of staff members to assign to each operating day."
                                       FontSize="13"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">

                            <TextBlock Margin="0,0,0,7"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#627069"
                                       Text="STAFF COUNT"/>

                            <TextBox x:Name="StaffPerDayBox"
                                     HorizontalContentAlignment="Center"
                                     Text="3"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- Exclusion list -->
                <Border Margin="0,18,0,0"
                        Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Exclusion heading -->
                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Exclude Staff"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <TextBlock Margin="0,5,0,0"
                                           Text="Selected staff members will not be included in the generated schedule."
                                           FontSize="13"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Margin="15,0,0,0"
                                    Padding="10,6"
                                    VerticalAlignment="Center"
                                    Background="#FFF8E8"
                                    BorderBrush="#ECD9A7"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="#A16617"
                                               Text="&#xE7BA;"/>

                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#73501D"
                                               Text="OPTIONAL"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <!-- Staff list -->
                        <Border Grid.Row="2"
                                MinHeight="220"
                                MaxHeight="330"
                                Background="#FAFCFB"
                                BorderBrush="#DDE5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">

                            <ScrollViewer Padding="10"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <ItemsControl x:Name="StaffCheckboxList">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border Margin="0,0,0,7"
                                                    Padding="12,10"
                                                    Background="White"
                                                    BorderBrush="#E1E8E4"
                                                    BorderThickness="1"
                                                    CornerRadius="7">

                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsExcluded}"/>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Border>

                    </Grid>

                </Border>

                <!-- Information -->
                <Border Margin="0,18,0,0"
                        Padding="14"
                        Background="#EEF5FA"
                        BorderBrush="#C9DBE8"
                        BorderThickness="1"
                        CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Top"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="#426E89"
                                   Text="&#xE946;"/>

                        <TextBlock Grid.Column="2"
                                   Text="The generated assignments should still be reviewed before the schedule is saved."
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="#536D7D"/>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- Footer buttons -->
        <Border Grid.Row="2"
                Padding="20,16"
                Background="White"
                BorderBrush="#DDE5E1"
                BorderThickness="0,1,0,0">

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">

                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Cancel"
                        IsCancel="True"/>

                <Button Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Generate_Click"
                        IsDefault="True">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Margin="0,0,7,0"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE895;"/>

                        <TextBlock Text="Generate Schedule"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>