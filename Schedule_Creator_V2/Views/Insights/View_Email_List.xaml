<Page x:Class="Schedule_Creator_V2.View_Email_List"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1100"
      Title="View Email List"
      Background="#F1F5F3"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- Main cards -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DDE5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="22"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect BlurRadius="14"
                                      Direction="270"
                                      ShadowDepth="3"
                                      Opacity="0.08"
                                      Color="#143D30"/>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Availability selector -->
        <Style TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#BFCBC5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- Email output -->
        <Style TargetType="TextBox">

            <Setter Property="Padding"
                    Value="12,10"/>

            <Setter Property="Background"
                    Value="#FAFCFB"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#CDD8D3"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="AcceptsReturn"
                    Value="True"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Top"/>

            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>

        </Style>

        <!-- Copy button -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="125"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Background"
                    Value="#0F5640"/>

            <Setter Property="BorderBrush"
                    Value="#0F5640"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#174E3D"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#174E3D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0A3E2E"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.50"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Data grid -->
        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E5EBE8"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>

            <Setter Property="RowHeaderWidth"
                    Value="0"/>

            <Setter Property="RowHeight"
                    Value="48"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="46"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FAFCFB"/>

            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#EAF2EE"/>

            <Setter Property="Foreground"
                    Value="#234438"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="13,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="BorderBrush"
                    Value="#D6E1DC"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Style.Triggers>

                <Trigger Property="AlternationIndex"
                         Value="1">

                    <Setter Property="Background"
                            Value="#FAFCFB"/>

                </Trigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F0F7F3"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#DDEFE7"/>

                    <Setter Property="Foreground"
                            Value="#1F2937"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="Padding"
                    Value="13,8"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

    </Page.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="54"
                    Height="54"
                    VerticalAlignment="Top"
                    Background="#DDEFE7"
                    CornerRadius="12">

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="26"
                           Foreground="#0F5640"
                           Text="&#xE715;"/>

            </Border>

            <StackPanel Grid.Column="2">

                <TextBlock Text="View Email List"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>

                <TextBlock Margin="0,5,0,0"
                           MaxWidth="820"
                           Text="Generate a copy-ready list of staff email addresses based on weekly availability."
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="#66736D"/>

            </StackPanel>

        </Grid>

        <!-- Main workspace -->
        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Availability filter -->
            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Availability Filter"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>

                        <TextBlock Margin="0,5,0,0"
                                   Text="Select a day to show available staff, or select No Availability to find staff without saved availability."
                                   FontSize="13"
                                   LineHeight="19"
                                   TextWrapping="Wrap"
                                   Foreground="#6B7280"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">

                        <TextBlock Margin="0,0,0,7"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#293A34"
                                   Text="Availability Selection"/>

                        <ComboBox x:Name="AvailabilityComboBox"
                                  SelectionChanged="LoadData"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Results -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.8*"/>
                </Grid.ColumnDefinitions>

                <!-- Copy-ready email list -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Heading -->
                        <StackPanel Grid.Row="0">

                            <StackPanel Orientation="Horizontal">

                                <Border Width="38"
                                        Height="38"
                                        Margin="0,0,10,0"
                                        Background="#E7F2ED"
                                        CornerRadius="8">

                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="#0F5640"
                                               Text="&#xE8BD;"/>

                                </Border>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Email Addresses"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"/>

                                    <TextBlock Margin="0,2,0,0"
                                               Text="Comma-separated recipient list"
                                               FontSize="11"
                                               Foreground="#7A8680"/>

                                </StackPanel>

                            </StackPanel>

                        </StackPanel>

                        <!-- Email output -->
                        <TextBox x:Name="EmailsTextBox"
                                 Grid.Row="2"
                                 MinHeight="260"
                                 IsReadOnly="True"
                                 ToolTip="Generated email addresses"/>

                        <!-- Copy action -->
                        <Grid Grid.Row="4">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Text="Paste this list into an email recipient field."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="#7A8680"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CopyButton_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Margin="0,0,7,0"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Text="&#xE8C8;"/>

                                    <TextBlock Text="Copy Emails"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Grid>

                </Border>

                <!-- Staff result grid -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Grid heading -->
                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Matching Staff"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <TextBlock Margin="0,4,0,0"
                                           Text="Staff records matching the selected availability option."
                                           FontSize="12"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                            <Border Grid.Column="1"
                                    Padding="10,6"
                                    VerticalAlignment="Center"
                                    Background="#EAF2EE"
                                    BorderBrush="#D4E2DB"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="#315E4D"
                                               Text="&#xE77B;"/>

                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#315E4D"
                                               Text="STAFF RESULTS"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <!-- DataGrid -->
                        <Border Grid.Row="2"
                                MinHeight="320"
                                Background="White"
                                BorderBrush="#DDE5E1"
                                BorderThickness="1"
                                CornerRadius="9"
                                ClipToBounds="True">

                            <DataGrid x:Name="UsersDataGrid">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Width="1.1*"
                                                        Binding="{Binding fName}"
                                                        Header="First Name"/>

                                    <DataGridTextColumn Width="1.1*"
                                                        Binding="{Binding lName}"
                                                        Header="Last Name"/>

                                    <DataGridTextColumn Width="2*"
                                                        Binding="{Binding email}"
                                                        Header="Email Address"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Page>