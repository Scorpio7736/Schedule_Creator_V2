<UserControl x:Class="Schedule_Creator_V2.EmailRichTextEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="5"
            Background="White">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FORMAT TOOLBAR -->
            <Border Grid.Row="0"
                    Padding="6"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <StackPanel Orientation="Horizontal">

                    <Button Width="32"
                            Height="28"
                            Margin="0,0,4,0"
                            Command="EditingCommands.ToggleBold"
                            CommandTarget="{Binding ElementName=Editor}"
                            ToolTip="Bold">

                        <TextBlock Text="B"
                                   FontWeight="Bold"/>

                    </Button>

                    <Button Width="32"
                            Height="28"
                            Margin="0,0,4,0"
                            Command="EditingCommands.ToggleItalic"
                            CommandTarget="{Binding ElementName=Editor}"
                            ToolTip="Italic">

                        <TextBlock Text="I"
                                   FontStyle="Italic"/>

                    </Button>

                    <Button Width="32"
                            Height="28"
                            Margin="0,0,12,0"
                            Command="EditingCommands.ToggleUnderline"
                            CommandTarget="{Binding ElementName=Editor}"
                            ToolTip="Underline">

                        <TextBlock Text="U"
                                   TextDecorations="Underline"/>

                    </Button>

                    <Button Height="28"
                            Padding="8,2"
                            Margin="0,0,4,0"
                            Command="EditingCommands.ToggleBullets"
                            CommandTarget="{Binding ElementName=Editor}"
                            Content="• List"
                            ToolTip="Bulleted List"/>

                    <Button Height="28"
                            Padding="8,2"
                            Command="EditingCommands.ToggleNumbering"
                            CommandTarget="{Binding ElementName=Editor}"
                            Content="1. List"
                            ToolTip="Numbered List"/>

                </StackPanel>

            </Border>

            <!-- EDITOR -->
            <RichTextBox x:Name="Editor"
                         Grid.Row="1"
                         MinHeight="120"
                         Padding="8"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         SpellCheck.IsEnabled="True"/>

        </Grid>

    </Border>

</UserControl>